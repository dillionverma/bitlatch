{
  "version": "0.2.1",
  "private": true,
  "description": "A quiet, fast Mac companion for your Bitwarden vault.",
  "homepage": "https://github.com/dillionverma/latch",
  "author": "Dillion Verma",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "desktopName": "latch.desktop",
  "name": "@latch/desktop",
  "scripts": {
    "dev": "node build/dev.mjs",
    "start": "electron .",
    "build": "pnpm --filter @latch/extension build:chrome && node build/build.mjs",
    "build:safari": "node --input-type=module -e \"import { buildSafari } from './build/build-safari.mjs'; await buildSafari(process.cwd())\"",
    "typecheck": "vp lint src electron-builder.ts build vite.config.mjs",
    "package": "pnpm build && electron-builder --mac dir --arm64",
    "package:mac": "pnpm build && electron-builder --mac --arm64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:autofill": "node build/package-autofill.mjs",
    "package:release": "node build/package-autofill.mjs --release"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.4.1",
    "electron-builder": "^26.8.1",
    "motion": "^13.4.2",
    "node-api-headers": "^1.9.0",
    "plist": "^5.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.2",
    "tw-animate-css": "^1.4.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "@latch/shared": "workspace:*"
  },
  "dependencies": {
    "electron-liquid-glass": "1.1.1",
    "electron-updater": "^6.8.9"
  }
}
