{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "latch",
  "title": "Latch",
  "description": "Unlock and search your Latch logins and secure notes.",
  "icon": "icon.png",
  "author": "dillionverma",
  "license": "GPL-3.0-only",
  "private": true,
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Security"
  ],
  "commands": [
    {
      "name": "search",
      "title": "Search Vault",
      "subtitle": "Latch",
      "description": "Unlock Latch, browse item details, and copy login fields or secure notes.",
      "mode": "view"
    },
    {
      "name": "lock",
      "title": "Lock Vault",
      "subtitle": "Latch",
      "description": "Lock Latch immediately.",
      "mode": "no-view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "typecheck": "pnpm -C .. exec vp check --no-fmt --no-lint raycast/src"
  },
  "dependencies": {
    "@raycast/api": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.0.10"
  },
  "packageManager": "pnpm@11.25.0"
}
