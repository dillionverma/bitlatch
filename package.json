{
  "name": "latch",
  "version": "0.2.1",
  "private": true,
  "description": "A quiet, fast Mac companion for your Bitwarden vault.",
  "homepage": "https://github.com/dillionverma/latch",
  "author": "Dillion Verma",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "desktopName": "latch.desktop",
  "scripts": {
    "dev": "pnpm run build && electron .",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "wxt prepare && vp check && pnpm run lint && pnpm run extension:typecheck && pnpm run build",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "package": "pnpm run build && electron-builder --mac dir --arm64",
    "package:mac": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:autofill": "node scripts/package-autofill.mjs",
    "package:release": "node scripts/package-autofill.mjs --release",
    "postinstall": "wxt prepare",
    "extension:dev": "wxt -b chrome",
    "extension:dev:firefox": "wxt -b firefox --mv3",
    "extension:build": "node scripts/build-extensions.mjs",
    "extension:zip": "node scripts/build-extensions.mjs --zip",
    "extension:typecheck": "wxt prepare && vp lint --tsconfig tsconfig.extension.json --max-warnings 0 src/extension src/shared wxt.config.ts",
    "extension:submit": "wxt submit",
    "lint": "vp lint --max-warnings 0",
    "lint:fix": "vp lint --fix",
    "desktop:build": "vp pack",
    "renderer:build": "vp build"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.4.1",
    "electron-builder": "^26.8.1",
    "motion": "^13.4.2",
    "node-api-headers": "^1.9.0",
    "plist": "^5.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.2",
    "tw-animate-css": "^1.4.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "wxt": "^0.21.4",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "electron-liquid-glass": "1.1.1",
    "electron-updater": "^6.8.9",
    "node-gyp-build": "4.8.4"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
