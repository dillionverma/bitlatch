{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, fast Mac companion for your Bitwarden vault.",
  "author": "Dillion Verma",
  "license": "GPL-3.0-only",
  "type": "module",
  "overrides": {
    "multer": "^2.3.0",
    "tmp": "^0.2.6"
  },
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "format": "prettier --write src scripts docs *.json *.md",
    "format:check": "prettier --check src scripts docs *.json *.md",
    "package": "npm run build && electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.4.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.577.0",
    "prettier": "^3.8.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "zod": "^4.3.6"
  },
  "build": {
    "appId": "app.latch.vault",
    "productName": "Latch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/extension/**/*",
      "dist/desktop/native-host.cjs",
      "node_modules/electron-liquid-glass/prebuilds/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null,
      "hardenedRuntime": true
    }
  },
  "dependencies": {
    "electron-liquid-glass": "1.1.1",
    "node-gyp-build": "4.8.4"
  }
}
