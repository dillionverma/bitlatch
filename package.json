{
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "name": "@latch/workspace",
  "scripts": {
    "dev": "pnpm --filter @latch/desktop dev",
    "start": "pnpm --filter @latch/desktop start",
    "build": "pnpm --filter @latch/desktop build && pnpm --filter @latch/extension build:firefox && pnpm --filter @latch/extension build:safari && pnpm --filter @latch/desktop build:safari && pnpm --filter latch build",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "pnpm -r --if-present typecheck",
    "typecheck": "pnpm -r --if-present typecheck",
    "package": "pnpm --filter @latch/desktop package",
    "package:mac": "pnpm --filter @latch/desktop package:mac",
    "package:linux": "pnpm --filter @latch/desktop package:linux",
    "package:win": "pnpm --filter @latch/desktop package:win",
    "package:autofill": "pnpm --filter @latch/desktop package:autofill",
    "package:release": "pnpm --filter @latch/desktop package:release",
    "extension:dev": "pnpm --filter @latch/extension dev",
    "extension:build": "pnpm --filter @latch/extension build",
    "extension:zip": "pnpm --filter @latch/extension zip",
    "extension:typecheck": "pnpm --filter @latch/extension typecheck",
    "extension:submit": "pnpm --filter @latch/extension submit",
    "extension:dev:firefox": "pnpm --filter @latch/extension dev:firefox"
  },
  "devDependencies": {
    "vite-plus": "1.0.0-rc.0"
  }
}
